{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "singleQuote": true,
  "semi": true,
  "tabWidth": 2,
  "trailingComma": "none",
  "arrowParens": "avoid",
  "endOfLine": "lf",
  "sortPackageJson": false,
  "svelte": true,
  "ignorePatterns": ["node_modules/", "dist/", "pnpm-lock.yaml"]
}
